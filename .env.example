# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://owing:owing@localhost:5433/owing
# Used by the integration tests (created by docker/initdb on first start)
TEST_DATABASE_URL=postgres://owing:owing@localhost:5433/owing_test
# Optional: Ollama server for the "Ask about your orders" box (e.g. a PC on
# your Tailscale network running `OLLAMA_HOST=0.0.0.0 ollama serve`).
# Leave OLLAMA_MODEL blank to use the first installed model.
OLLAMA_URL=
OLLAMA_MODEL=

# Wake-on-LAN for the Ollama PC ("Start-Beeniara-Ai" button). A small "wol"
# sidecar (host network) sends the packet; the app only asks it. Use the PC's
# physical LAN adapter MAC, not Tailscale. Blank MAC hides/disables waking.
PC_MAC_ADDRESS=
WOL_BROADCAST=192.168.1.255
# Only these account emails (comma-separated) may wake the PC. Blank = nobody.
WAKE_ALLOWED_EMAILS=
# Seconds after a wake during which an unreachable PC counts as "waking".
WAKE_WINDOW_SECONDS=180

# Remote shutdown ("Shut down PC" button). Tailscale IP + Windows user of the PC,
# and a key in ./wol-sidecar/ssh/id_ed25519 that the PC only lets run `shutdown`.
# Blank host hides the button. Uses the same WAKE_ALLOWED_EMAILS allow-list.
PC_SSH_HOST=
PC_SSH_USER=
