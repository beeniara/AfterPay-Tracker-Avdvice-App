# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://owing:owing@localhost:5433/owing
# Used by the integration tests (created by docker/initdb on first start)
TEST_DATABASE_URL=postgres://owing:owing@localhost:5433/owing_test
# Optional: Ollama server for the "Ask about your orders" box (e.g. a PC on
# your Tailscale network running `OLLAMA_HOST=0.0.0.0 ollama serve`).
# Leave OLLAMA_MODEL blank to use the first installed model.
OLLAMA_URL=
OLLAMA_MODEL=
